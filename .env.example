# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000

# ── Database (Neon managed Postgres for MVP) ─────────────────────────────────
# Neon: postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/db?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lombok_exotic

# ── Auth (better-auth) ──────────────────────────────────────────────────────
# generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-byte-random-string
BETTER_AUTH_URL=http://localhost:3000

# ── Payment (Midtrans Snap — SANDBOX keys for the pitch demo) ────────────────
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
# optional: comma-separated Midtrans notification source IPs to allowlist
MIDTRANS_WEBHOOK_ALLOWLIST=

# ── Shipping (Biteship — TEST key) ──────────────────────────────────────────
BITESHIP_API_KEY=biteship_test_xxxxxxxxxxxxxxxx
BITESHIP_WEBHOOK_SECRET=replace-with-random-string
# Biteship area id of the store origin (Senggigi / Mataram) — set after lookup
STORE_ORIGIN_AREA_ID=

# ── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM="Lombok Exotic <noreply@lombokexotic.example>"

# ── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=
