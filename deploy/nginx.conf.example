# /etc/nginx/sites-available/lombok-exotic
# Cloudflare sits in front (proxied DNS). This box only accepts 80/443.
# certbot --nginx -d lombokexotic.com -d www.lombokexotic.com

server {
    listen 80;
    server_name lombokexotic.com www.lombokexotic.com;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name lombokexotic.com www.lombokexotic.com;

    ssl_certificate     /etc/letsencrypt/live/lombokexotic.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lombokexotic.com/privkey.pem;

    # Real client IP from Cloudflare (refresh list from cloudflare.com/ips).
    # set_real_ip_from 173.245.48.0/20;  # ... add all CF ranges
    real_ip_header CF-Connecting-IP;

    client_max_body_size 12m;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # Next.js static assets — immutable, long cache.
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_cache_valid 200 60m;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }
}
